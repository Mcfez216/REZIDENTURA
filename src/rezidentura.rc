// rezidentura.rc - the program's icon and version information (Windows resources).
#include <winver.h>

1 ICON "rezidentura.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,6,0,0
PRODUCTVERSION 1,6,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Rezidentura"
            VALUE "FileDescription", "Rezidentura - a KGB case officer's career, 1968-1991"
            VALUE "FileVersion", "1.6.0"
            VALUE "InternalName", "Rezidentura"
            VALUE "OriginalFilename", "Rezidentura.exe"
            VALUE "ProductName", "Rezidentura"
            VALUE "ProductVersion", "1.6.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
